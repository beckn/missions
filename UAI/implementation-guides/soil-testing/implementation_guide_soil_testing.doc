        "message_id": "e2e56f14-72fd-4cb5-b8c4-6e269ce87e68",
        "timestamp": "2025-04-29T09:01:03Z"
    },
    "message": {
        "order": {
            "provider": {
                "id": "krishikendra.bpp.uki.in",
                "descriptor": {
                    "name": "Krishi Kendra Soil Services",
                    "short_desc": "Comprehensive Soil Testing at your farm or lab"
                }
            },
            "items": [
                {
                    "id": "soil-npk-test",
