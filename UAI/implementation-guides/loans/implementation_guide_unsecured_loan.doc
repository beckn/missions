        "timestamp": "2025-06-02T09:01:30Z",
        "ttl": "PT10S"
    },
    "message": {
        "order": {
            "provider": {
                "id": "prov01"
            },
            "items": [
                {
                    "id": "loan-agriboost-50k",
                    "tags": [
                        {
                            "descriptor": {
                                "code": "applicant-details"
                            },
                            "list": [
                                {
                                    "descriptor": {
                                        "code": "AADHAR"
                                    },
                                    "value": "BPQMR****"
                                },
