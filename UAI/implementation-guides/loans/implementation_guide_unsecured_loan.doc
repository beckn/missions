                                    "descriptor": {
                                        "code": "PAN"
                                    },
                                    "value": "MNWP976****"
                                },
                                {
                                    "descriptor": {
                                        "code": "Bank-account-number"
                                    },
                                    "value": "122242****"
                                },
                                {
                                    "descriptor": {
