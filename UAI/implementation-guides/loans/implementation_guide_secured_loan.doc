        "domain": "credit-services:uki",
        "action": "select",
        "version": "1.1.0",
        "location": {
            "city": {
                "code": "std:95253"
            },
            "country": {
                "code": "IND"
            }
        },
        "bap_id": "credit-fpo.bap.uki.in",
